{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "pilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "targets": [{"expr": "sum by (route) (rate(pilot_http_requests_total[5m]))", "legendFormat": "{{route}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "pilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "HTTP 5xx ratio",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(pilot_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(pilot_http_requests_total[5m])), 1)", "legendFormat": "5xx ratio"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "pilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (route, le) (rate(pilot_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "pilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "Inflight requests",
      "type": "timeseries",
      "targets": [{"expr": "pilot_http_inflight_requests", "legendFormat": "inflight"}]
    }
  ],
  "schemaVersion": 39,
  "tags": ["pilot", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Pilot Overview",
  "uid": "pilot-overview",
  "version": 1
}
